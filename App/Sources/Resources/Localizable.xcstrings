    "onboarding.firstRound.grade" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann deckst du auf und sagst, wie gut du es wusstest. Ehrlich schlägt großzügig: Deine Antwort entscheidet, wann du das Wort wiedersiehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then you reveal and say how well you knew it. Honest beats generous: your answer decides when you see the word again."
          }
        }
      }
    },
    "onboarding.firstRound.recognize" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Spross dir ein Wort zeigt, nimm dir einen Moment: Kommt es dir bekannt vor?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Spross shows you a word, take a moment. Does it ring a bell?"
          }
        }
      }
    },
    "onboarding.firstRound.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine erste Runde"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first round"
          }
        }
      }
    },
    "onboarding.firstRound.write" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wort, das du nicht wusstest, schreibst du einmal ab. Taucht es wieder auf, tippst du es aus dem Gedächtnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A word you didn't know gets written once. When it turns up again, you type it from memory."
          }
        }
      }
    },
    "onboarding.languages.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
