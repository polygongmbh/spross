    },
    "onboarding.firstRound.write" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wort, das du nicht wusstest, darfst du einmal abschreiben, damit es besser hängen bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you don't know a word, you can write it out once to solidify your memory."
          }
