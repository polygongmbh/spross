    "home.greeting.morning.addressee" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frühaufsteher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "early bird"
          }
        }
      },
      "comment" : "Who a spoken line is addressed to when no name is known: the hour lends the word, and it goes INSIDE the target-language sentence (\"Tayari kujifunza, Nachteule?\"), so it is never rendered on its own. Morning and night only — nobody is a night owl at two in the afternoon."
    },
