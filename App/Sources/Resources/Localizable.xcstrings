    "onboarding.welcome" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei Spross!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Spross!"
          }
        }
      }
    },
    "onboarding.why.breadth.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar neue Wörter am Tag, so verteilt, dass sie bleiben. Lieber viele Wörter ein bisschen kennen als wenige perfekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few new words a day, spaced so they stay. Better to know many words a little than a few perfectly."
          }
        }
      }
    },
    "onboarding.why.breadth.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesät, nicht gepaukt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sown, not crammed"
          }
        }
      }
    },
    "onboarding.why.companion.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spross ersetzt weder deinen Kurs noch deinen Sprachpartner. Zwischen den Gesprächen wächst dein Wortschatz weiter, damit du beim nächsten Mal mehr zu sagen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spross doesn't replace your course or your language partner. Your vocabulary keeps growing between conversations, so you have more to say next time."
          }
        }
      }
    },
    "onboarding.why.companion.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begleiter, kein Ersatz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A companion, not a replacement"
          }
        }
      }
    },
    "onboarding.why.grammar.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spross bringt dir keine Grammatik bei, nur das Geschlecht der Wörter. Wo du die Wörter wirklich benutzt, kommt der Rest von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spross doesn't teach grammar, just the gender a word carries. Where you actually use the words, the rest takes care of itself."
          }
        }
      }
    },
    "onboarding.why.grammar.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grammatik kommt vom Sprechen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grammar comes from speaking"
          }
        }
      }
    },
    "onboarding.why.title" : {
