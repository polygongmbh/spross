   "phrases": [
    {
     "de": "Ich habe um zehn Uhr einen Termin in der Praxis.",
     "sw": "Nina miadi kwenye kliniki saa nne asubuhi.",
     "note": "saa nne = wörtl. „vierte Stunde“! Die Swahili-Uhr startet um 6 Uhr morgens: 10 Uhr = saa 4"
    },
    {
     "de": "Mein Hals tut sehr weh.",
     "sw": "Koo linaniuma sana.",
     "note": "wörtl. „Die Kehle schmerzt mich sehr“ — der Körperteil ist das Subjekt!"
    },
    {
     "de": "Ich habe seit gestern Fieber.",
     "sw": "Nina homa tangu jana."
    },
    {
     "de": "Bitte nehmen Sie die Tabletten zweimal täglich ein.",
     "sw": "Tafadhali kunywa vidonge mara mbili kwa siku.",
     "note": "wörtl. „Trinken Sie die Tabletten …“ — Medizin wird auf Swahili getrunken, auch Tabletten!"
    },
    {
     "de": "Gute Besserung!",
     "sw": "Pole! Upone haraka!",
     "note": "pole = Mitgefühls-Wort ohne deutsches Gegenstück; upone haraka wörtl. „mögest du schnell heilen“"
    },
    {
     "de": "Mit dem Rezept gehen Sie zur Apotheke.",
     "sw": "Nenda na cheti cha dawa hadi duka la dawa.",
     "note": "wörtl. „Geh mit dem Medizin-Zettel zum Medizin-Laden“ — dawa steckt in beiden!"
    },
    {
     "de": "Zeigen Sie mir bitte Ihre Versichertenkarte.",
     "sw": "Tafadhali nionyeshe kadi yako ya bima ya afya."
    },
    {
     "de": "Ich muss den Termin leider absagen.",
     "sw": "Samahani, lazima nighairi miadi.",
     "note": "miadi sieht aus wie ein Plural (mi-), ist aber Einzahl — arabisches Lehnwort"
    }
   ]
