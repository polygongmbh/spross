   "phrases": [
    {
     "de": "Hallo! / Guten Tag!",
     "sw": "Hujambo! / Habari!",
     "note": "„Hujambo?“ wörtl. „Hast du kein Problem?“ — Antwort: „Sijambo!“"
    },
    {
     "de": "Danke schön!",
     "sw": "Asante sana!",
     "note": "wörtl. „Danke sehr!“"
    },
    {
     "de": "Bitte!",
     "sw": "Tafadhali! / Karibu!",
     "note": "tafadhali = „bitte“ beim Bitten · karibu = „bitte sehr!“ beim Geben — wörtl. „Komm näher!“, auch „Willkommen!“"
    },
    {
     "de": "Entschuldigung!",
     "sw": "Samahani!"
    },
    {
     "de": "Ja. / Nein.",
     "sw": "Ndiyo. / Hapana."
    },
    {
     "de": "Wie heißen Sie? — Ich heiße …",
     "sw": "Unaitwa nani? — Naitwa …",
     "note": "wörtl. „Du wirst wer genannt? — Ich werde … genannt.“ — kuitwa in Frage UND Antwort"
    },
    {
     "de": "Woher kommen Sie?",
     "sw": "Unatoka wapi?"
    },
    {
     "de": "Sprechen Sie Englisch?",
     "sw": "Unazungumza Kiingereza?",
     "note": "Ki- = Sprach-Präfix: Kiingereza, Kijerumani, Kiswahili"
    },
    {
     "de": "Ich spreche nur ein bisschen Deutsch.",
     "sw": "Ninazungumza Kijerumani kidogo tu."
    },
    {
     "de": "Ich weiß nicht.",
     "sw": "Sijui.",
     "note": "wieder si-: najua „ich weiß“ → sijui"
    },
    {
     "de": "Wie bitte?",
     "sw": "Samahani, naomba urudie.",
     "note": "naomba = „ich bitte (darum)“ — das höfliche Allzweckwort"
    },
    {
     "de": "Ich brauche Hilfe.",
     "sw": "Nahitaji msaada."
    },
    {
     "de": "Alles gut.",
     "sw": "Hakuna shida.",
     "note": "wörtl. „Es gibt kein Problem.“ — wie das berühmte „hakuna matata“"
    },
    {
     "de": "Auf Wiedersehen! / Tschüss!",
     "sw": "Kwaheri!",
     "note": "wörtl. „Mit Glück/Segen!“ (kwa heri) · zu mehreren: Kwaherini!"
    },
    {
     "de": "Wie nennt man das?",
     "sw": "Hii inaitwaje?",
     "note": "wörtl. „Dies wird-genannt-wie?“ — -je am Verbende = „wie?“; wieder kuitwa!"
    },
    {
     "de": "Wie geht es Ihnen? — Danke, gut.",
     "sw": "Habari yako? — Nzuri, asante!",
     "note": "wörtl. „Deine Neuigkeiten? — Gut, danke!“ — die Antwort ist fast immer nzuri"
    },
    {
     "de": "Können Sie das bitte wiederholen?",
     "sw": "Unaweza kurudia, tafadhali?"
    },
    {
     "de": "Ich verstehe.",
     "sw": "Naelewa."
    },
    {
     "de": "Ich verstehe nicht.",
     "sw": "Sielewi.",
     "note": "si- ersetzt nina- und die Endung wechselt -a → -i: naelewa → sielewi"
    },
    {
     "de": "Langsamer, bitte!",
     "sw": "Polepole, tafadhali!",
     "note": "polepole (ein Wort) = „schön langsam“ — die Verdopplung von pole (sachte)"
    }
   ]
