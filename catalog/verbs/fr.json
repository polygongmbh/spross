{
 "title": "Les verbes essentiels",
 "subtitle": "Ce qu'il te faut partout.",
 "words": {
  "go": {
   "text": "aller",
   "notes": {
    "de": "aller = gehen und fahren · zu Fuß betont: aller à pied."
   }
  },
  "come": {
   "text": "venir"
  },
  "have": {
   "text": "avoir"
  },
  "give": {
   "text": "donner"
  },
  "take": {
   "text": "prendre"
  },
  "see": {
   "text": "voir",
   "notes": {
    "de": "voir = wahrnehmen · regarder = bewusst anschauen."
   }
  },
  "make": {
   "text": "faire",
   "notes": {
    "de": "faire deckt machen und tun ab: faire la cuisine, faire ses devoirs."
   }
  },
  "like": {
   "text": "aimer",
   "notes": {
    "de": "aimer heißt mögen und lieben; abgeschwächt aimer bien: j'aime bien ce café."
   }
  },
  "can": {
   "text": "pouvoir",
   "notes": {
    "de": "unregelmäßig: je peux, tu peux, il peut, nous pouvons."
   }
  },
  "think": {
   "text": "penser",
   "notes": {
    "de": "penser à quelque chose = an etwas denken · penser que = glauben, dass."
   }
  },
  "wait": {
   "text": "attendre",
   "notes": {
    "de": "attendre steht ohne Präposition: j'attends le bus."
   }
  },
  "do-you-have-water": {
   "text": "Avez-vous de l'eau ?",
   "variants": [
    "Vous avez de l'eau ?",
    "As-tu de l'eau ?",
    "Tu as de l'eau ?"
   ],
   "notes": {
    "de": "Nach avoir steht der Teilungsartikel: de l'eau, nicht bloß eau."
   }
  },
  "where-are-you-from": {
   "text": "D'où venez-vous ?",
   "variants": [
    "Vous venez d'où ?",
    "D'où viens-tu ?",
    "Tu viens d'où ?"
   ]
  }
 }
}
