{
 "title": "Idioms",
 "words": {
  "buy-a-pig-in-a-poke": {
   "text": "Don't buy a pig in a poke.",
   "notes": { "de": "Wörtlich: „Kauf kein Schwein im Beutel.“" }
  },
  "cross-your-fingers": {
   "text": "I'm crossing my fingers for you!",
   "notes": {
    "de": "Wörtlich: „Ich kreuze meine Finger für dich.“",
    "es": "Literalmente: 'Cruzo mis dedos por ti.'"
   }
  },
  "put-your-foot-in-it": {
   "text": "I really put my foot in it.",
   "notes": {
    "de": "Wörtlich: „Ich habe wirklich meinen Fuß hineingesteckt.“",
    "es": "Literalmente: 'Metí el pie en ello.'"
   }
  },
  "pull-someones-leg": { "text": "He was pulling my leg.", "notes": { "de": "Wörtlich: „Er zog an meinem Bein.“" } },
  "fed-up-to-here": {
   "text": "I've had it up to here.",
   "notes": {
    "de": "Wörtlich: „Ich hatte es bis hierhin“ (mit einer Geste an den Hals).",
    "es": "Literalmente: 'Lo he tenido hasta aquí.'"
   }
  },
  "turn-a-blind-eye": {
   "text": "He turned a blind eye.",
   "notes": {
    "de": "Wörtlich: „Er wandte ein blindes Auge zu.“",
    "es": "Literalmente: 'Volvió un ojo ciego.'"
   }
  },
  "seventh-heaven": {
   "text": "She's in seventh heaven.",
   "notes": { "de": "Wörtlich dasselbe Bild: „im siebten Himmel“.", "es": "Literalmente la misma imagen." }
  },
  "bite-the-bullet": { "text": "Just bite the bullet!", "notes": { "de": "Wörtlich: „Beiß einfach in die Kugel!“" } },
  "raining-cats-and-dogs": {
   "text": "It's raining cats and dogs.",
   "notes": {
    "de": "Wörtlich: „Es regnet Katzen und Hunde.“",
    "es": "Literalmente: 'Están lloviendo gatos y perros.'"
   }
  }
 }
}
