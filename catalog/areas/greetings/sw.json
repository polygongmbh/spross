{
 "title": "Salamu na adabu",
 "subtitle": "Unachosema mnapokutana.",
 "words": {
  "to-thank": { "text": "kushukuru" },
  "name": { "text": "jina", "grammar": { "plural": "majina" } },
  "to-be-called": { "text": "kuitwa" },
  "hello": { "text": "Hujambo!", "notes": { "sw": "Hujambo? — Sijambo. · Hamjambo? — Hatujambo." } },
  "good-day": {
   "text": "Habari!",
   "notes": {
    "de": "Habari grüßt zu jeder Tageszeit; die Antwort ist immer Nzuri, auch wenn es nicht stimmt."
   }
  },
  "good-morning": { "text": "Habari za asubuhi!" },
  "good-evening": { "text": "Habari za jioni!" },
  "good-night": { "text": "Usiku mwema!" },
  "goodbye": { "text": "Kwaheri!" },
  "welcome": {
   "text": "Karibu!",
   "accepts": ["Karibuni!"],
   "notes": { "de": "Auch die Antwort auf „Hodi?“ und die Einladung „Komm herein!“ · an mehrere: Karibuni!" }
  },
  "greetings-elder": {
   "text": "Shikamoo!",
   "notes": {
    "sw": "Shikamoo! — Marahaba.",
    "de": "Respektgruß an Ältere; die Antwort ist immer „Marahaba!“ · unter Gleichaltrigen bleibt es bei „Hujambo!“"
   }
  },
  "may-i-come-in": { "text": "Hodi!", "notes": { "sw": "Hodi! — Karibu!" } },
  "how-are-you": { "text": "Habari yako?" },
  "all-good": { "text": "Yote ni sawa.", "accepts": ["Yote sawa."] },
  "thank-you": { "text": "Asante sana!" },
  "please": { "text": "Tafadhali!" },
  "excuse-me": { "text": "Samahani!" },
  "no-problem": { "text": "Hakuna matata!", "teaches": ["Hakuna shida!"] },
  "pardon": { "text": "Umesemaje?" },
  "sorry-to-hear-that": {
   "text": "Pole!",
   "accepts": ["Pole sana!", "Poleni!"],
   "notes": {
    "sw": "Pole! — Asante.",
    "de": "Mitgefühl bei jedem Missgeschick, auch beim Stolpern oder nach der Arbeit — nie eine Entschuldigung für eigene Schuld · an mehrere: Poleni!"
   }
  },
  "whats-your-name": { "text": "Unaitwaje?", "accepts": ["Unaitwa nani?"] },
  "my-name-is": { "text": "Naitwa …" },
  "yes": { "text": "Ndiyo." },
  "no": { "text": "Hapana." }
 }
}
