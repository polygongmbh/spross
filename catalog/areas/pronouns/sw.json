  "you": { "text": "wewe", "notes": { "sw": "wewe: u- (u-nasikia) na -ku- (ni-na-ku-sikia)." } },
  "he": {
   "text": "yeye",
   "notes": { "sw": "yeye ni mwanaume au mwanamke: a- (a-nasikia) na -m- (ni-na-m-sikia)." }
  },
  "we": { "text": "sisi", "notes": { "sw": "sisi: tu- (tu-nasikia) na -tu- (a-na-tu-sikia)." } },
