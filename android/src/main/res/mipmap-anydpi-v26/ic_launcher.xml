<?xml version="1.0" encoding="utf-8"?>
<!-- The iOS icon's own artwork, inset into the safe circle over the plate it is painted
     on (`scripts/android-icon.py`). The themed layer stays a vector: a monochrome mask
     is a silhouette the launcher tints, which a painted sprout cannot be. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
