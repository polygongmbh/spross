<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The paper the app is drawn on, light column. Copied from `Palette.background`
         (kern's `Palette.kt`, read by ui/ThemeColors.kt): the window is what a cold start shows before the first frame of
         Compose, and a value picked here rather than copied is a flash of the wrong app.
         The dark column stands in values-night/. -->
    <color name="spross_window_background">#FFF2F1EA</color>
    <!-- The plate the icon artwork is painted on, so a mask cutting the foreground's
         square exposes the same color the art sits on. Written from the source by
         `scripts/android-icon.py`, whose check mode fails once it drifts. -->
    <color name="ic_launcher_background">#FFEECE9E</color>
</resources>
