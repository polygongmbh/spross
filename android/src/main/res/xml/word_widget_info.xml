<?xml version="1.0" encoding="utf-8"?>
<!-- What the launcher needs to know about the word tile before it has ever drawn one.

     It arrives two cells square — the small face — and resizes freely in both directions up
     to the whole grid, so ONE placed tile can be any of the three families. Which face a
     given size gets is WordWidget's buckets, not this file's; the maxima here only have to
     be wide and tall enough that the poster is reachable on a phone.

     updatePeriodMillis is thirty minutes because that is the shortest the platform will
     schedule — anything smaller is silently clamped. It is a CEILING on staleness rather
     than the refresh that matters: the app nudges the tile on every persist, so a phone
     in use redraws far more often, and this only covers the phone nobody has opened.

     The picker's thumbnail is the app's own mark. A placed tile only ever shows the
     learner's own box (docs/surfaces.md), and the picker cannot read one. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="480dp"
    android:maxResizeHeight="480dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:updatePeriodMillis="1800000" />
