<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The boosting half of the audio analysis index: the LoudnessEnhancer that lifts the
         quiet recordings is an AudioEffect, and attaching one is what this covers. A normal
         permission — granted at install, never prompted, nothing to ask the learner. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Speech engines live in their own packages, which package visibility hides
         since Android 11: without this the pinned engine cannot even be bound, and
         every word without a recording would fall silent. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="Spross"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spross">
        <activity
            android:name=".SprossActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
