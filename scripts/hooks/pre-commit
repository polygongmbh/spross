#!/bin/sh
# Guard the two generated layouts nothing else checks.
#
# Python's json defaults omit the space Xcode puts before every colon, so a writer
# that reaches for json.dump rewrites all 4500 lines of the String Catalog and buries
# a one-value edit in a diff nobody can review. The catalog/ tree has the same trap
# without Xcode to notice it. Neither check may ever be the reason a commit is hard.
#
# Installed by scripts/bootstrap.sh (`git config core.hooksPath scripts/hooks`).
set -e
cd "$(git rev-parse --show-toplevel)"

CATALOG=App/Sources/Resources/Localizable.xcstrings
STAGED=$(git diff --cached --name-only)

if printf '%s\n' "$STAGED" | grep -qx "$CATALOG"; then
  # The staged bytes, not the working tree's — those are what the commit would carry.
  BYTES=$(mktemp)
  trap 'rm -f "$BYTES"' EXIT
  git show ":$CATALOG" > "$BYTES"

  if ! scripts/strings.py --check-format "$BYTES" >/dev/null 2>&1; then
    echo "error: $CATALOG is staged in some other formatting than Xcode's." >&2
    echo "       Run 'scripts/strings.py --fix', then stage it again — your values are kept." >&2
    exit 1
  fi

  # The Android tables are generated FROM the catalog, so a catalog edit that does not
  # carry them along would ship the two phones saying different things — the one drift
  # the generator exists to make impossible.
  if ! scripts/chrome.py >/dev/null; then
    echo "error: the Android chrome tables are not what $CATALOG says." >&2
    echo "       Run 'scripts/chrome.py --fix' and stage ChromeDe.kt/ChromeEn.kt too." >&2
    exit 1
  fi
fi

# The content catalog's layout is generated too, and its rule lived only in CLAUDE.md —
# where 78% of catalog commits shipped off-layout anyway. Recorded audio carries no
# layout, so a commit that only moves mp3s is not held up for it.
if printf '%s\n' "$STAGED" | grep -E '^catalog/' | grep -qv '^catalog/audio/'; then
  if ! python3 scripts/catalog-format.py --check >/dev/null 2>&1; then
    echo "error: catalog/ is staged off its canonical layout." >&2
    echo "       Run 'python3 scripts/catalog-format.py --fix', then stage it again." >&2
    exit 1
  fi
fi
